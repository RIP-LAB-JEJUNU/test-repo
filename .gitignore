*.root
*.h5
*.hdf5
*.npy
*.npz
data/

# ── 파이썬 부산물 ──
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ── 에디터·OS ──
.vscode/
